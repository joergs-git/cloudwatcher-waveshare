menu "CloudWatcher Configuration"

    config CW_WIFI_SSID
        string "WiFi SSID"
        default "MyNetwork"
        help
            WiFi network name to connect to.

    config CW_WIFI_PASSWORD
        string "WiFi Password"
        default "MyPassword"
        help
            WiFi network password.

    config CW_HOST_IP
        string "CloudWatcher IP Address"
        default "192.168.1.151"
        help
            IP address of the AAG CloudWatcher Solo device.

    config CW_HOST_PORT
        int "CloudWatcher HTTP Port"
        default 80
        help
            HTTP port of the CloudWatcher device.

    config CW_POLL_INTERVAL_S
        int "Current data poll interval (seconds)"
        default 60
        help
            How often to fetch current sensor data from lastData.pl.

    config CW_GRAPH_POLL_INTERVAL_S
        int "Graph data poll interval (seconds)"
        default 240
        help
            How often to fetch 24h graph data from graphData.pl.

    config CW_ALLSKY_KEOGRAM_URL
        string "Allsky Keogram Image URL"
        default "https://192.168.1.50/indi-allsky/images/keograms/keogram_realtime.jpg"
        help
            Direct URL to the indi-allsky realtime keogram JPEG image.
            Must be a direct image URL (not an HTML page).

    config CW_ALLSKY_POLL_INTERVAL_S
        int "Allsky image poll interval (seconds)"
        default 300
        help
            How often to fetch the allsky keogram image (default 5 minutes).

endmenu

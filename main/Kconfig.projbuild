menu "CloudWatcher Configuration"

    config CW_WIFI_SSID
        string "WiFi SSID"
        default "MyNetwork"
        help
            WiFi network name to connect to.

    config CW_WIFI_PASSWORD
        string "WiFi Password"
        default "MyPassword"
        help
            WiFi network password.

    config CW_HOST_IP
        string "CloudWatcher IP Address"
        default "192.168.1.151"
        help
            IP address of the AAG CloudWatcher Solo device.

    config CW_HOST_PORT
        int "CloudWatcher HTTP Port"
        default 80
        help
            HTTP port of the CloudWatcher device.

    config CW_POLL_INTERVAL_S
        int "Current data poll interval (seconds)"
        default 60
        help
            How often to fetch current sensor data from lastData.pl.

    config CW_GRAPH_POLL_INTERVAL_S
        int "Graph data poll interval (seconds)"
        default 240
        help
            How often to fetch 24h graph data from graphData.pl.

endmenu

menu "NINA Configuration"

    config NINA_HOST_IP
        string "NINA PC IP Address"
        default "192.168.1.114"
        help
            IP address of the imaging PC running N.I.N.A. with the Advanced API plugin.

    config NINA_HOST_PORT
        int "NINA API Port"
        default 1888
        help
            HTTP port of the ninaAPI Advanced API plugin.

    config NINA_DOME_PORT
        int "NINA Dome API Port"
        default 1888
        help
            HTTP port of the NINA instance controlling the dome (may differ from image instance).

    config DOME_CONTROLLER_IP
        string "Dome Controller IP Address"
        default "192.168.1.177"
        help
            IP address of the AstroShell dome Arduino controller (direct ASCOM query).

    config DOME_CONTROLLER_PORT
        int "Dome Controller Port"
        default 80
        help
            HTTP port of the AstroShell dome Arduino controller.

    config NINA_POLL_INTERVAL_S
        int "NINA image poll interval (seconds)"
        default 120
        help
            How often to fetch the latest image and dome status from NINA (default: 2 minutes).

endmenu
